# Copy to .env and fill in. Never commit .env.

# Deployer/client private key. The drivers read DEPLOYER_PRIVATE_KEY first, then
# fall back to the project wallet at D:\Genlayer-project\wallet\.env
# (GENLAYER_DEV_KEY). Override the wallet location with OBSERVA_KEY_FILE.
DEPLOYER_PRIVATE_KEY=

# Provider key for start_deal in the end-to-end demo. Falls back to
# D:\Genlayer-project\wallet\seller.json. Override with OBSERVA_SELLER_KEY.
OBSERVA_SELLER_KEY=

# Optional wallet locations.
OBSERVA_KEY_FILE=
OBSERVA_SELLER_KEY_FILE=
OBSERVA_WALLET_DIR=

# Existing deployment, used by demo/verify instead of deploying a fresh one.
OBSERVA_ADDRESS=

# Copy the deployed address here as well for the frontend:
# frontend/.env.local -> NEXT_PUBLIC_OBSERVA_ADDRESS=
NEXT_PUBLIC_OBSERVA_ADDRESS=
